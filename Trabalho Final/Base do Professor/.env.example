LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-915ea76461404115a0ebaba9f22cda3f
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Para economizar, deixe thinking desativado no desenvolvimento.
DEEPSEEK_THINKING=disabled
REASONING_EFFORT=high

DATASET_PATH=data/covid19.csv
CSV_SEPARATOR=,
MAX_AGENT_ITERATIONS=8
MAX_TOKENS_PER_RESPONSE=900
NUMERIC_TOLERANCE=0.05
